[Unit]
Description=Marketing Pilot (agentisches Marketing-Tool, Modul des AI-Empire-Dashboards)
After=network-online.target

[Service]
User=developer
WorkingDirectory=/home/developer/ai_empire/marketing-pilot
ExecStart=/usr/bin/node dist/server/src/server/index.js
Restart=always
RestartSec=3
MemoryMax=1G
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/developer/.cache/ms-playwright
EnvironmentFile=-/home/developer/ai_empire/marketing-pilot/.env

[Install]
WantedBy=multi-user.target
