[Unit]
Description=Marketing Pilot Worker (Video-Renders, lange Jobs)
After=network-online.target app-marketing-pilot.service

[Service]
User=developer
WorkingDirectory=/home/developer/ai_empire/marketing-pilot
ExecStart=/usr/bin/node dist/server/src/server/worker.js
Restart=always
RestartSec=3
MemoryMax=3G
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/developer/.cache/ms-playwright
EnvironmentFile=-/home/developer/ai_empire/marketing-pilot/.env

[Install]
WantedBy=multi-user.target
