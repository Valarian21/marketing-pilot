# Marketing Pilot - copy to .env (chmod 600). Never commit .env.
# Values with (Shot N) are not used before that shot but reserved now.

# --- Host mode --------------------------------------------------------------
# false = module inside the AI-Empire dashboard (auth via dashboard JWT)
# true  = standalone app with its own login
MP_STANDALONE=false
MP_HOST=127.0.0.1
MP_PORT=8105
# Where mp.db, session secret and generated assets live
MP_DATA_DIR=./data
# Public origin used in UTM links and deep links (Shot 3+)
MP_PUBLIC_BASE=https://agi-empire.com

# --- Dashboard mode ---------------------------------------------------------
# Secret file of the dashboard (HS256). Leave empty to use the default path
# ../dashboard/data/jwt_secret.txt relative to this package.
MP_HOST_JWT_SECRET_FILE=
# Alternative: pass the secret directly (takes precedence over the file)
MP_HOST_JWT_SECRET=
# Link shown in the sidebar to leave the module
MP_HOST_BACK_LINK=/

# --- Standalone mode --------------------------------------------------------
MP_STANDALONE_USER=marcel
MP_STANDALONE_PASSWORD=change-me
# Optional; generated into MP_DATA_DIR/session_secret.txt when empty
MP_SESSION_SECRET=

# --- Providers --------------------------------------------------------------
OPENROUTER_API_KEY=
# Override the defaults from config/models.ts
MP_MODEL_STRONG=
MP_MODEL_CHEAP=
MP_MODEL_IMAGE=
# GEO baseline engines (Shot 1), comma-separated OpenRouter model ids
MP_GEO_MODELS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# manual | postiz
MP_PUBLISH_PROVIDER=manual
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Web search (Shot 1): none | brave | serper ; empty falls back to DuckDuckGo HTML
MP_SEARCH_PROVIDER=
MP_SEARCH_API_KEY=

# --- Test / demo product (Shot 1 + 4) ----------------------------------------
MP_TEST_PROJECT_URL=https://lehreule.de
MP_DEMO_BASE_URL=
MP_DEMO_USER=
MP_DEMO_PASSWORD=
MP_DEMO_RESET_URL=

# --- Inbound events webhook (Shot 5) -----------------------------------------
MP_EVENTS_TOKEN=
